  "motion": {
    "$description": "Apple-style springs (perceived duration in s, bounce 0 = no overshoot) for every morph; press feedback and fades use the curves. The pin's morph: the old content fades out evenly in pin-out-ms as the surface starts to spring, and the next content comes in once the surface is pin-in-at of the way to the card (riding its top edge) or within pin-mini-at of the mini pin. The splash: my dot pops in (spring-pop, from splash-pop-from), TripUp at splash-word-at-ms; small stickers pop up at random spots all over the screen from splash-stickers-at-ms, a splash-sticker-stagger-ms apart, and pop away the same way, in the same order, from splash-stickers-out-at-ms. At splash-leave-at-ms, once the last sticker has started to go, the dot and then TripUp (splash-leave-stagger-ms later) slide out to the left by splash/slide, fading late so the slide reads; once TripUp is half way out, Your trips staggers in from the right by as much. Paying: the bank app comes in like any other phone screen (page-zoom-scale); Face ID scans for face-id-ms, then Approved shows for approved-ms before TripUp comes back. A swap in place (a pop-up title, a footer) brings the new one in once the old is swap-in-at of the way out, so the two never read over each other.",
    "spring-morph": {
      "duration": 0.45,
      "bounce": 0.12
    },
    "spring-expand": {
      "duration": 0.55,
      "bounce": 0.08
    },
    "spring-collapse": {
      "duration": 0.38,
      "bounce": 0
    },
    "spring-open": {
      "duration": 0.45,
      "bounce": 0
    },
    "spring-snap": {
      "duration": 0.35,
      "bounce": 0
    },
    "spring-pop": {
      "duration": 0.4,
      "bounce": 0.3
    },
    "press-scale": 0.97,
    "press-ms": 120,
    "fade-ms": 160,
    "pin-out-ms": 150,
    "pin-in-at": 0.55,
    "pin-mini-at": 0.35,
    "splash-pop-from": 0.6,
    "splash-word-at-ms": 220,
    "splash-stickers-at-ms": 80,
    "splash-sticker-stagger-ms": 50,
    "splash-stickers-out-at-ms": 800,
    "splash-leave-at-ms": 1400,
    "splash-leave-stagger-ms": 60,
    "face-id-ms": 900,
    "approved-ms": 600,
    "swap-in-at": 0.4,
    "crossfade-blur": 2,
    "stagger-ms": 40,
    "open-delay-ms": 220,
    "open-stagger-ms": 30,
    "open-item-ms": 200,
    "fold-ms": 200,
    "stagger-max": 8,
    "enter-ms": 260,
    "page-enter-delay-ms": 80,
    "toast-ms": 3000,
    "toast-action-ms": 6000,
    "settle-ms": 800,
    "pulse-ms": 1200,
    "scan-find-ms": 600,
    "scan-read-ms": 900,
    "enter-blur": 4,
    "morph-enter-scale": 0.9,
    "page-zoom-scale": 1.04,
    "ease-out": [
