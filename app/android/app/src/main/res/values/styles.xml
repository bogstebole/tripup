<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app draws edge to edge, under see-through system bars, like on iOS (MainActivity and main.dart do the rest).
         The window behind Flutter is Your trips' blue (@color/home_bg, from the design tokens), so the launch screen
         already looks like the first screen, bars included, and nothing flashes white. The app has no dark mode, so
         there's no values-night. Below Android 8 the navigation bar stays the system's opaque one (see values-v26). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/home_bg</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
